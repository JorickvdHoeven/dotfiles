# Ghostty Configuration
# Synced from iTerm2 settings

# Font Configuration
font-family = FiraCode Nerd Font Mono
font-size = 11
font-thicken = false
freetype-load-flags = no-hinting
font-feature = +calt  # Enable ligatures
font-feature = +liga  # Enable ligatures
font-feature = +dlig  # Enable discretionary ligatures

# Window Configuration
window-width = 80
window-height = 25
window-padding-x = 2
window-padding-y = 2

# Appearance
background-opacity = 1.0
background-blur-radius = 20

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-color = #ffffff
cursor-invert-fg-bg = true

# Colors
background = #1a1a1a
foreground = #e0e0e0

# ANSI Color Palette (from iTerm)
palette = 0=#14191e
palette = 1=#b43c29
palette = 2=#00c200
palette = 3=#c7c400
palette = 4=#5577ff
palette = 5=#bf3fbd
palette = 6=#00c5c7
palette = 7=#c7c7c7
palette = 8=#676767
palette = 9=#dc7974
palette = 10=#57e690
palette = 11=#ece100
palette = 12=#a6aaf1
palette = 13=#e07de0
palette = 14=#5ffdff
palette = 15=#feffff

# Scrollback (very large limit)
scrollback-limit = 999999

# Mouse
mouse-hide-while-typing = true

# Shell Integration
shell-integration = detect
shell-integration-features = sudo,title,no-cursor

# macOS Specific
macos-non-native-fullscreen = false
macos-option-as-alt = true
macos-titlebar-style = transparent

# Linux Specific
gtk-titlebar = true

# Theme
window-theme = ghostty
window-titlebar-background = #1a1a1a
window-titlebar-foreground = #e0e0e0

# Performance
resize-overlay = never
